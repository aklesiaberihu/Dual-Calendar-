@startuml Activity_DateConversion
title Zemen — Activity Diagram: Ethiopian ↔ Gregorian Date Conversion

skinparam activity {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
  FontName Arial
}
skinparam ActivityDiamondBackgroundColor #EEF5FB
skinparam ActivityDiamondBorderColor #3498db
skinparam ActivityStartColor #2ECC71
skinparam ActivityEndColor #E74C3C

|Client|
start
:Provide date input\n(year, month, day)\nand direction (g2e or e2g);

|API Router /convert|
:Receive HTTP GET request;

if (direction == "g2e"?) then (yes)
  :Parse Gregorian year, month, day\nas Python date object;
  note right: Invalid values raise ValueError\nfrom Python's date() constructor\n(implicit validation — no explicit check)

  |DateConversionService|
  :Call gregorian_to_ethiopian(g_date);
  :Apply conversion algorithm\n(returns eth_year, eth_month, eth_day);
  :Look up month name\nfrom ETH_MONTHS dict;
  :Return {year, month, day, month_name};

else (no — direction == "e2g")
  :Parse Ethiopian year, month, day\nas integers;

  if (month < 1 or month > 13\nor day < 1 or day > 30\nor year <= 0?) then (invalid)
    :Return HTTP 400\nBad Request;
    note right: _validate_ethiopian_date()\nchecks month 1-13, day 1-30,\nyear > 0; raises HTTPException(400)
    stop
  else (valid)
    |DateConversionService|
    :Call ethiopian_to_gregorian(year, month, day);
    :Apply conversion algorithm\n(returns Gregorian date object);
    :Return {year, month, day};
  endif
endif

|API Router /convert|
:Serialize result to JSON;
:Return HTTP 200 with result;

|Client|
:Display converted date\nin user's preferred calendar;
stop

@enduml
