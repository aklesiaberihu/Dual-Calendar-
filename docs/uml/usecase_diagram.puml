@startuml Zemen_UseCases
!define SYSTEMID Zemen Dual Calendar System
skin rose

actor "User" as User
actor "Reminder\nService" as ReminderSvc
actor "Google OAuth\nProvider" as GoogleOAuth

rectangle SYSTEMID {
  usecase "Register / Sign Up" as UC_Register
  usecase "Login" as UC_Login
  usecase "Login via Google" as UC_GoogleLogin
  usecase "View Calendar\n(Gregorian)" as UC_ViewGregorian
  usecase "View Calendar\n(Ethiopian)" as UC_ViewEthiopian
  usecase "Switch Calendar\nPreference" as UC_SwitchCal
  usecase "Create Event" as UC_CreateEvent
  usecase "Edit Event" as UC_EditEvent
  usecase "Delete Event" as UC_DeleteEvent
  usecase "View Event\nDetails" as UC_ViewEvent
  usecase "Share Event\nwith Others" as UC_ShareEvent
  usecase "View Shared\nEvents" as UC_ViewShared
  usecase "Convert Date\n(Gregorian ↔ Ethiopian)" as UC_ConvertDate
  usecase "Suggest Meeting\nSlots" as UC_SuggestSlots
  usecase "Rank Meeting\nSlots by\nConstraints" as UC_RankSlots
  usecase "Set Event\nReminder" as UC_SetReminder
  usecase "Manage User\nProfile" as UC_ManageProfile
  usecase "View Holidays" as UC_ViewHolidays
}

User --> UC_Register
User --> UC_Login
User --> UC_ViewGregorian
User --> UC_ViewEthiopian
User --> UC_SwitchCal
User --> UC_CreateEvent
User --> UC_EditEvent
User --> UC_DeleteEvent
User --> UC_ViewEvent
User --> UC_ShareEvent
User --> UC_ViewShared
User --> UC_ConvertDate
User --> UC_SuggestSlots
User --> UC_RankSlots
User --> UC_SetReminder
User --> UC_ManageProfile
User --> UC_ViewHolidays

GoogleOAuth --> UC_GoogleLogin
UC_GoogleLogin --> UC_Login : <<include>>
UC_Login --> UC_Register : actor can also register
UC_CreateEvent --> UC_SetReminder : <<include>>
UC_SuggestSlots --> UC_ConvertDate : <<include>>
UC_RankSlots --> UC_SuggestSlots : <<extend>>
UC_ViewEvent --> UC_ConvertDate : <<include>>
UC_ShareEvent --> UC_EditEvent : requires edit rights
ReminderSvc --> UC_SetReminder : sends reminders

@enduml
