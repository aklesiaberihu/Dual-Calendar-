@startuml Zemen_UseCases
!pragma layout smetana
title Zemen — Use Case Diagram: Registered User

skinparam actor {
  BackgroundColor White
  BorderColor #333333
  FontName Arial
}
skinparam usecase {
  BackgroundColor #EEF5FB
  BorderColor #3498db
  FontName Arial
}
skinparam ArrowColor #555555

actor "Anonymous User\n(unauthenticated)" as Anon
actor "Registered User\n(authenticated)" as Reg
actor "Google OAuth\n(accounts.google.com)" as GoogleOAuth
actor "ReminderService\n(SMTP daemon)" as ReminderSvc

Anon <|-- Reg

rectangle "Zemen Dual Calendar System" {

  usecase "Register Account\n(email + password)" as UC_Register
  usecase "Login\n(email + password)" as UC_Login
  usecase "Login via Google\n(OAuth2 flow)" as UC_GoogleLogin

  usecase "View Calendar\n(Gregorian layout)" as UC_ViewGregorian
  usecase "View Calendar\n(Ethiopian layout)" as UC_ViewEthiopian
  usecase "Switch Calendar\nPreference" as UC_SwitchCal

  usecase "Convert Date\n(Gregorian ↔ Ethiopian,\nincl. Pagume month 13)" as UC_ConvertDate

  usecase "Create Event\n(single or recurring;\nbecomes owner)" as UC_CreateEvent
  usecase "View & Search\nOwn Events" as UC_ViewOwnEvents
  usecase "View Shared\nEvents" as UC_ViewShared

  usecase "View Holidays\n(Ethiopian & Gregorian)" as UC_ViewHolidays

  usecase "Find Free Slots\nAcross Participants\n(/schedule/rank)" as UC_ScheduleRank

  usecase "Manage Profile\n(timezone, language,\ncalendar preference)" as UC_ManageProfile
  usecase "Connect Google\nCalendar (OAuth2)" as UC_GoogleConnect
  usecase "Disconnect Google\nCalendar" as UC_GoogleDisconnect

  usecase "Receive Email\nReminder" as UC_ReceiveReminder

}

Anon --> UC_Register
Anon --> UC_Login
Anon --> UC_GoogleLogin

Reg --> UC_ViewGregorian
Reg --> UC_ViewEthiopian
Reg --> UC_SwitchCal
Reg --> UC_ConvertDate
Reg --> UC_CreateEvent
Reg --> UC_ViewOwnEvents
Reg --> UC_ViewShared
Reg --> UC_ViewHolidays
Reg --> UC_ScheduleRank
Reg --> UC_ManageProfile
Reg --> UC_GoogleConnect
Reg --> UC_GoogleDisconnect

GoogleOAuth --> UC_GoogleLogin   : callback
GoogleOAuth --> UC_GoogleConnect : callback
ReminderSvc --> UC_ReceiveReminder : SMTP

UC_GoogleLogin ..> UC_Login         : <<extends>>
UC_GoogleConnect ..> UC_ManageProfile : <<extends>>
UC_GoogleDisconnect ..> UC_ManageProfile : <<extends>>

note bottom of UC_CreateEvent
  Recurrence supported:
  daily / weekly / monthly
  (no "yearly" rule in backend —
  "every year" maps to monthly/12)
  end_type: count (1-365) or until-date
end note

note bottom of UC_ScheduleRank
  POST /schedule/rank
  Organiser provides participant emails
  + time window + duration.
  IntervalService finds free gaps;
  RankingService scores by work-hours
  and optional-user conflicts.
end note

@enduml
