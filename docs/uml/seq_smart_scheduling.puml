@startuml Sequence_Smart_Scheduling
title Zemen — Sequence Diagram: Smart Scheduling Pipeline

skinparam sequenceArrowThickness 1.5
skinparam roundcorner 6
skinparam FontName Arial

actor       "Organiser"       as O
participant "React Frontend"  as FE
participant "FastAPI /events\n/rank"     as API
participant "IntervalService" as IS
participant "RankingService"  as RS
database    "PostgreSQL"      as DB

== Organiser Opens Smart Scheduling Panel ==

O -> FE : Open event id=42\n(has 3 participants)\nSet window 09:00–17:00\nDuration: 60 min
FE -> API : GET /events/42/rank?\nduration_minutes=60\n&window_start_utc=...\n&window_end_utc=...\n&work_start_hour=9\n&work_end_hour=17

== Collect Participant Busy Times ==

API -> DB : SELECT event_participants\nWHERE event_id=42
DB --> API : [{user_id:1, role:"owner"},\n{user_id:2, role:"editor"},\n{user_id:3, role:"viewer"}]

loop for each participant user_id
  API -> DB : SELECT events WHERE user_id=N\nAND start_time_utc BETWEEN\nwindow_start AND window_end
  DB --> API : [busy events for user N]
end

== Merge Intervals (all participants) ==

API -> IS : merge_intervals(\nall_busy_intervals)
note right : Overlapping/touching\nintervals collapsed into\nminimal set
IS --> API : merged_busy: [(09:00,10:00),\n(11:30,13:00), (15:00,16:00)]

== Find Free Gaps ==

API -> IS : find_gaps(\nwindow_start=09:00,\nwindow_end=17:00,\nbusy=merged_busy)
IS --> API : gaps: [(10:00,11:30),\n(13:00,15:00),\n(16:00,17:00)]

== Generate Candidate Slots ==

API -> IS : choose_slots(\ngaps, duration=60,\nlimit=20)
IS --> API : candidates: [(10:00,11:00),\n(13:00,14:00),\n(14:00,15:00),\n(16:00,17:00)]

== Rank Candidates ==

API -> RS : rank_slots(\nslots=candidates,\nbusy_by_user={1:[...],2:[...],3:[...]},\nrequired_users={1,2,3},\noptional_users={},\nwork_start_hour=9, work_end_hour=17)

loop for each candidate slot
  RS -> RS : Check required users\n(HARD: exclude slot if any conflict)
  RS -> RS : Check optional users\n(SOFT: +100 per conflict)
  RS -> RS : Check work hours\n(SOFT: +50 if outside 09:00–17:00)
  RS -> RS : score_to_rating(score)\n(⭐⭐⭐⭐⭐ IDEAL / ⭐⭐⭐⭐ EXCELLENT / ...)
end

RS --> API : ranked: [\n{start:"10:00", score:0,\nrating:"⭐⭐⭐⭐⭐ IDEAL",\nreasons:["Everyone free, within work hours"]},\n{start:"13:00", score:0, rating:"⭐⭐⭐⭐⭐ IDEAL",\nreasons:["Everyone free, within work hours"]},\n{start:"16:00", score:0,\nrating:"⭐⭐⭐⭐⭐ IDEAL",\nreasons:["Everyone free, within work hours"]}\n]

== Return Results ==

API --> FE : 200 {\nranked_slots: [...],\nparticipants: [...],\nconstraints: {...}\n}

FE --> O : Display ranked slots\n(green = ideal, yellow = penalty)\nUser clicks a slot to use it

O -> FE : Click slot "10:00–11:00"
FE -> FE : Populate start/end\ntime fields with selection
FE --> O : Form filled with chosen slot

@enduml
