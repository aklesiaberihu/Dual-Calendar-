@startuml Activity_ConstraintRanking
title Zemen — Activity Diagram: Constraint-Based Slot Ranking

skinparam activity {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
  FontName Arial
}
skinparam ActivityDiamondBackgroundColor #EEF5FB
skinparam ActivityDiamondBorderColor #3498db
skinparam ActivityStartColor #2ECC71
skinparam ActivityEndColor #E74C3C

start

:Input:\n• candidate_slots: list of (start, end)\n• busy_by_user: {user_id → [(start,end), ...]}\n• required_users: set of user_ids\n• optional_users: set of user_ids\n• work_start_hour, work_end_hour: int\n• tz_name: str = "UTC";

:ranked = [];

repeat
  :Take next candidate slot S\n(start, end);

  :score = 0;
  :reasons = [];

  ' ── Required users ─────────────────────────────────────────────────────
  :Check every required user R;
  repeat
    :busy_intervals = busy_by_user[R];
    if (slot_conflicts_for_user(busy_intervals, S)?) then (conflict)
      :EXCLUDE this slot entirely\n(skip — do not add to ranked);
      note right: Hard constraint:\nRequired user busy → slot invalid
      break
    else (free)
    endif
  repeat while (more required users?)

  if (slot was excluded?) then (yes)
    :continue to next slot;
  else (no — all required users free)

    ' ── Optional users ───────────────────────────────────────────────────
    :Check every optional user O;
    repeat
      :busy_intervals = busy_by_user[O];
      if (slot_conflicts_for_user(busy_intervals, S)?) then (conflict)
        :score += 100;
        :reasons.append("N optional participant(s) have conflicts");
      else (free)
      endif
    repeat while (more optional users?)

    ' ── Work hours ───────────────────────────────────────────────────────
    if (NOT in_work_hours(S.start,\nwork_start_hour, work_end_hour, tz_name)?) then (outside)
      :score += 50;
      :reasons.append("Outside standard work hours (9-17)");
      note right: Soft constraint:\n+50 penalty if slot start\nis outside work hours
    else (inside)
    endif

    ' ── Append result ────────────────────────────────────────────────────
    if (reasons is empty?) then (yes)
      :reasons = ["Everyone free, within work hours"];
    else (no)
    endif

    :rated = score_to_rating(score)\n(≤50→IDEAL, ≤150→EXCELLENT,\n≤250→GOOD, ≤350→FAIR, else→POOR);

    :ranked.append({\n  start: S.start,\n  end: S.end,\n  score: score,\n  rating: rated,\n  reasons: reasons\n});

  endif

repeat while (more candidate slots?)

:Sort ranked by score ascending\n(lower score = better);

:Return all ranked slots\n(sorted by score ascending);
note right: rank_slots() returns ALL ranked slots;\ncaller (router) slices to max_results
stop

@enduml
