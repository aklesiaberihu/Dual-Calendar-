// Keep compatibility if anything imports login()
export async function login(email, password) {
  return loginUser(email, password);
}

// ---------------- Profile (matches Settings.jsx imports) ----------------
export function getProfile() {
  return request("/profile", { auth: true });
}

export function updateProfile(payload) {
  return request("/profile", { method: "PUT", body: payload, auth: true });
}

// ---------------- Events ----------------
export function listEvents() {
  return request("/events", { auth: true });
}

export function getEvent(id) {
  return request(`/events/${id}`, { auth: true });
}

export function createEvent(payload) {
  return request("/events", { method: "POST", body: payload, auth: true });
}

export function updateEvent(id, payload) {
  return request(`/events/${id}`, { method: "PUT", body: payload, auth: true });
}

export function deleteEvent(id) {
  return request(`/events/${id}`, { method: "DELETE", auth: true });
}

// ---------------- Conversion ----------------
export function e2g(year, month, day) {
  return request(`/convert/e2g?year=${year}&month=${month}&day=${day}`, { auth: false });
}

export function g2e(year, month, day) {
  return request(`/convert/g2e?year=${year}&month=${month}&day=${day}`, { auth: false });
}
